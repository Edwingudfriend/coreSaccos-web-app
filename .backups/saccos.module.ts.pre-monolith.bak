 * SACCOS feature module — lazy-loaded.
 */
import { NgModule } from '@angular/core';
import { HTTP_INTERCEPTORS } from '@angular/common/http';

import { SaccosRoutingModule } from './saccos-routing.module';
import { SaccosLandingComponent } from './landing/saccos-landing.component';
import { SaccosJwtInterceptor } from './core/saccos-jwt.interceptor';

@NgModule({
  imports: [
    SaccosRoutingModule,
    SaccosLandingComponent
  ],
  providers: [
    { provide: HTTP_INTERCEPTORS, useClass: SaccosJwtInterceptor, multi: true }
  ]
})
export class SaccosModule {}
